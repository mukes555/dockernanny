{
  "name": "dockernanny",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts eslint.config.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "motion": "^13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.17.0"
}
